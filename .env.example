# Never commit your real token. Create a new one in @BotFather if it was ever shared.
BOT_TOKEN=replace_with_a_new_token
# Public HTTPS address of this server, used by Telegram's Mini App button.
APP_URL=https://your-domain.example
PORT=3000
# Use only while viewing the UI locally without Telegram. Leave empty in production.
DEV_USER_ID=

